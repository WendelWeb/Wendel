# ——— Base de données ———
DATABASE_URL=

# ——— Auth ———
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
SEED_EMAIL=
SEED_PASSWORD=

# ——— Email du matin (5h, Resend) ———
# Clé API Resend : https://resend.com/api-keys
RESEND_API_KEY=

# Les 4 adresses qui reçoivent le brief, séparées par des virgules.
MORNING_EMAIL_TO=adresse1@x.com,adresse2@x.com,adresse3@x.com,adresse4@x.com

# Expéditeur. Sans domaine vérifié chez Resend, garder onboarding@resend.dev
# (ne permet d'envoyer qu'à l'adresse du compte Resend).
# Avec un domaine vérifié : "FORGED <forge@tondomaine.com>"
MORNING_EMAIL_FROM=FORGED <onboarding@resend.dev>

# Secret protégeant /api/cron/morning. Vercel Cron l'envoie automatiquement
# en Bearer. Génère-le : openssl rand -hex 32
CRON_SECRET=

# URL publique de l'app, pour le bouton "Ouvrir FORGED" dans l'email.
APP_URL=https://ton-app.vercel.app
